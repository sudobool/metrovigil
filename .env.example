# MetroVigil – Environment Configuration
# Optional: Set your Google Gemini API Key for vision-based OCR extraction
# If left blank, MetroVigil automatically falls back to local Tesseract OCR / rule engine
GEMINI_API_KEY=

# Application Secret Key — used to sign login tokens.
# Leave this blank for local/demo use: MetroVigil will auto-generate a
# random key at startup (logins will need to happen again after a
# restart). For any real deployment, set a real secret here instead —
# generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database connection string (defaults to SQLite)
DATABASE_URL=sqlite+aiosqlite:///./lmpc.db

# Storage directories
UPLOAD_DIR=uploads
